GOOGLE_API_KEY=your_gemini_api_key

# Live job listings (Adzuna). If both values are present and LIVE_JOBS=auto,
# the API will fetch fresh listings for each resume instead of using data/job.csv.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_PAGE=30
LIVE_JOBS=auto
